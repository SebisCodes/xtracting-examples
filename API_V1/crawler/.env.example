# Copy to .env before starting.

# ── This copy of the stack ──────────────────────────────────────────────
# Must match ARCHIVE_STACK in ../database/.env. It decides which network this
# crawler joins; a different value means joining a network the database is not
# on, and the crawler will sit there waiting for a host that never resolves.
ARCHIVE_STACK=xtracting

# ── Your Xtracting API keys ─────────────────────────────────────────────
# Comma separated, and here the label matters more than in the collector:
# every source in the dashboard points at one of these labels, and that is how
# a source knows which project its documents end up in.
#
#     XTRACTING_API_KEYS=flats:ab12cd34.xxxx,law:ef56gh78.yyyy
#
# A source whose label is not in this list is not an error - the crawler
# records "unknown key label" on it and the dashboard shows it. Its documents
# wait in the queue until the key appears.
XTRACTING_API_KEYS=

# Optional. Keys meant for reading a project rather than submitting to it,
# kept apart only so this file stays readable - every key in both variables is
# probed the same way and judged by what it answers.
#
# What one buys: the dashboard can then show what each key of that project is
# set to run with, and offer "lowest effort" and "highest effort" when you pick
# one. Without it a key is offered by name and nothing more.
XTRACTING_PROJECT_KEYS=
XTRACTING_API_URL=https://api.xtracting.io

# ── Where the archive is ────────────────────────────────────────────────
# Credentials must match what you set in ../database/.env.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xtracting_archive
POSTGRES_USER=xtracting

# Which machine the database is on. Three cases:
#
#   xtracting_db           the container from ../database, reached over the
#                          shared network. The default, and correct whenever you
#                          started that folder with compose.
#
#   192.168.1.20           a database on another machine - hostname or IP.
#     or db.example.com
#
#   host.docker.internal   a database running on THIS machine but outside a
#                          container. Podman uses host.containers.internal.
#                          Do not put localhost here: inside a container that
#                          means the container itself, not your machine.
POSTGRES_HOST=xtracting_db

# The port on that machine. 5432 is right for POSTGRES_HOST=xtracting_db even
# if you published the database on another port in ../database/.env - that
# setting is where the port appears on your machine, and the crawler is not
# going through your machine.
POSTGRES_PORT=5432

# Or replace all five lines above with one connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# If you ran database/init/04-roles.sh, the crawler has a login of its own:
# SELECT on processed_data and scraper_config, ALL on crawler. Set it here and
# the boundary between the two services is enforced by the database rather than
# agreed between them.
# SCRAPER_DB_USER=xtracting_crawler
# SCRAPER_DB_PASSWORD=

# ── How it behaves towards the sites it reads ───────────────────────────
# WHO YOU ARE. Put a name and an address someone can reach you at. A crawler
# that cannot be contacted gets blocked instead of asked to slow down, and
# "robots.txt allows it" is not the same as "you have permission" - see
# docs/USAGE.md.
CRAWLER_USER_AGENT=xtracting-crawler/1.0 (+https://example.com/crawler; crawler@example.com)

# How many sources are crawled at the same time. Never two on the same host -
# that brake is per host and independent of this number. With Rendered sources
# each one is a browser, and a browser is some 300 MB.
CRAWLER_CONCURRENCY=2

# How often the scheduler looks for work. It is not how often a site is read -
# that is the interval on the source, six hours by default.
CRAWLER_TICK_SECONDS=5

# How long a claimed source stays claimed before another worker may take it.
# It only has to outlast a normal run; a crashed worker's source becomes free
# again after this.
CRAWLER_LEASE_MINUTES=30

# The cap for one downloaded file. Files above it are recorded as TOO_LARGE
# after reading at most this much - the reading stops, it is not a check
# afterwards. A source can lower it per file type.
CRAWLER_FILE_MAX_MB=25

# ── How it submits ──────────────────────────────────────────────────────
# How often the queue is emptied towards the API.
CRAWLER_SUBMIT_INTERVAL_SECONDS=60

# The API's own limits. Lower them if you like; raising them beyond these
# numbers only moves the refusal from here to the gateway in front of the API,
# where the answer is an HTML error page instead of a message.
CRAWLER_MAX_BATCH_TASKS=1000
CRAWLER_MAX_REQUEST_BYTES=4500000
CRAWLER_MAX_CONTENT_CHARS=2000000

# How often the crawler checks which submitted documents have arrived in the
# archive. This is what turns "submitted" into "archived" on the Watched pages view.
CRAWLER_RECONCILE_MINUTES=15
# How often the keys are asked what they are and which projects they open.
CRAWLER_KEY_REFRESH_SECONDS=300

# ── Rarely needed ───────────────────────────────────────────────────────
# The cap for one `--test` run from the command line. The dashboard has its own
# setting for the tests it runs itself.
CRAWLER_TEST_TIMEOUT_SECONDS=120

# true: keep the heartbeat and the configuration sync, crawl nothing and submit
# nothing. For a container that only exists to run `python -m app.main --test`.
CRAWLER_ONLY_TESTS=false

LOG_LEVEL=INFO
