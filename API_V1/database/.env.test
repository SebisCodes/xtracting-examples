# ============================================================
# A second, THROW-AWAY archive for the test suites - its own Compose
# project, network and volume, so a test run can never touch the archive
# you actually keep.
#
#   cd database
#   docker compose --env-file .env.test up -d
#   docker compose --env-file .env.test down -v     # and it is gone
#
# IN THE REPOSITORY ON PURPOSE. Nothing here is a secret: the database
# below is empty until a suite fills it, the port is bound to 127.0.0.1,
# and the password protects a container that is deleted again at the end
# of the run. A fresh clone needs this file to run the tests at all, which
# is why .gitignore is careful not to swallow it.
#
# The port is deliberately not 5432, so that the archive you use every day
# - or any other PostgreSQL on this machine - keeps its own port and no
# suite can reach it by mistake.
#
# The suites run on the HOST and reach it through the published port:
#
#   export DATABASE_URL=postgresql://xtracting:test_password@127.0.0.1:55432/xtracting_archive
# ============================================================
ARCHIVE_STACK=xtractingtest
POSTGRES_PASSWORD=test_password
POSTGRES_DB=xtracting_archive
POSTGRES_USER=xtracting
POSTGRES_PORT=55432
