# Copy to .env before starting.

# ── This copy of the stack ──────────────────────────────────────────────
# Must match ARCHIVE_STACK in ../database/.env. It decides which network this
# collector joins; a different value means joining a network the database is
# not on, and the collector will sit there waiting for a host that never
# resolves.
ARCHIVE_STACK=xtracting

# ── Your Xtracting API keys ─────────────────────────────────────────────
# Comma separated. Each key belongs to exactly one project, and the collector
# asks the API which - you never configure project names here.
#
# Optionally label a key so the logs read well:
#     XTRACTING_API_KEYS=plant-docs:ab12cd34.xxxx,market:ef56gh78.yyyy
XTRACTING_API_KEYS=

# ── Where to write ──────────────────────────────────────────────────────
# Credentials must match what you set in ../database/.env.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xtracting_archive
POSTGRES_USER=xtracting

# Which machine the database is on. Three cases:
#
#   db                     the container from ../database, reached over the
#                          shared network. The default, and correct whenever you
#                          started that folder with compose.
#
#   192.168.1.20           a database on another machine - hostname or IP.
#     or db.example.com
#
#   host.docker.internal   a database running on THIS machine but outside a
#                          container. Podman uses host.containers.internal.
#                          Do not put localhost here: inside a container that
#                          means the container itself, not your machine.
POSTGRES_HOST=xtracting_db

# The port on that machine. 5432 is right for POSTGRES_HOST=xtracting_db even if you
# published the database on another port in ../database/.env - that setting is
# where the port appears on your machine, and the collector is not going through
# your machine. Change this only when connecting from outside the network.
POSTGRES_PORT=5432

# Or replace all five lines above with one connection string, for any PostgreSQL
# carrying the archive schema:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Behaviour ───────────────────────────────────────────────────────────
XTRACTING_API_URL=https://api.xtracting.io
# How often to look for new results.
POLL_INTERVAL_MINUTES=15
# Seconds between keys, so ten keys do not hit the API in the same second.
KEY_STAGGER_SECONDS=20

# How far back to look when working out what is already archived. Results live
# about an hour on the platform, so anything older cannot be fetched again
# whether or not we remember it. Two hours suits any polling interval up to an
# hour; shorter than twice the interval and tasks get fetched twice.
COLLECTED_LOOKBACK_HOURS=2

# ── Leave this alone unless you know why you are changing it ────────────
# false (default): results are read with retain=true. Reading them here does not
#   consume the one look the platform gives you, and the platform clears the
#   content on its own schedule - about an hour. Your dashboard keeps working
#   and a failed write costs nothing but a retry.
#
# true: the content is deleted from the platform the moment it is read, BEFORE
#   this collector has committed it to the database. If the database is down, a
#   disk is full, or the container is killed at that instant, THOSE EXTRACTIONS
#   ARE GONE. They cannot be fetched again and you have paid for them.
#
#   The only reason to turn this on is a requirement that content leave the
#   platform as early as possible. It buys you roughly one hour, at the cost of
#   your only safety net.
CLEAR_CONTENT_ON_FETCH=false

LOG_LEVEL=INFO
