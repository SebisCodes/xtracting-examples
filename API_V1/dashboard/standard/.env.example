# Copy to .env before starting.

# ── This copy of the stack ──────────────────────────────────────────────
# Must match ARCHIVE_STACK in ../../database/.env. It decides which network this
# dashboard joins; a different value means joining a network the database is
# not on, and the dashboard will sit there waiting for a host that never
# resolves.
ARCHIVE_STACK=xtracting

# ── Where the archive is ────────────────────────────────────────────────
# Credentials must match what you set in ../../database/.env.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xtracting_archive
POSTGRES_USER=xtracting

# Which machine the database is on. Three cases:
#
#   xtracting_db           the container from ../../database, reached over the
#                          shared network. The default, and correct whenever you
#                          started that folder with compose.
#
#   192.168.1.20           a database on another machine - hostname or IP.
#     or db.example.com
#
#   host.docker.internal   a database running on THIS machine but outside a
#                          container. Podman uses host.containers.internal.
#                          Do not put localhost here: inside a container that
#                          means the container itself, not your machine.
POSTGRES_HOST=xtracting_db

# The port on that machine. 5432 is right for POSTGRES_HOST=xtracting_db even
# if you published the database on another port in ../../database/.env - that
# setting is where the port appears on your machine, and the dashboard is not
# going through your machine. Change this only when connecting from outside
# the network.
POSTGRES_PORT=5432

# Or replace all five lines above with one connection string, for any PostgreSQL
# carrying the archive schema:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Where the dashboard appears ─────────────────────────────────────────
# Bound to 127.0.0.1 on your machine. Set the gate password below, or put
# your reverse proxy in front of this port, before letting anyone else reach it.
DASHBOARD_PORT=8088

# ── Its own tables ──────────────────────────────────────────────────────
# The dashboard keeps buckets and connection colours in a schema of its own,
# `dashboard`, next to the archive. true (default): it creates and seeds that
# schema itself on start, and does nothing on later starts. false: it only
# checks the schema is there and stops with a message if not - for databases
# where the application user is not allowed to create anything, and someone
# ran sql/01-dashboard-schema.sql by hand.
DASHBOARD_SEED=true

# ── Maps ────────────────────────────────────────────────────────────────
# Where map tiles come from. The default is OpenStreetMap's public server,
# whose usage policy is written for light, attributed use - fine for a handful
# of people, not for a busy intranet. Point this at your own tile server or a
# provider you have an agreement with; {z}/{x}/{y} are filled in by the map.
DASHBOARD_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# The two lists a suggestion box is answered from - the addresses behind the
# Query page's place suggestions and the hosts behind the "by domain" ones -
# are materialized views refreshed on this interval. Both arrive with the
# collector, so fifteen minutes matches its polling; a shorter interval only
# costs a scan.
DASHBOARD_PLACES_REFRESH_MINUTES=15

# ── Xtracting itself ────────────────────────────────────────────────────
# Where the other half of the pair is. This dashboard reads an archive; the
# extraction that fills it, the projects and the keys that may extract all
# live over there, and several pages link out to it - the bar at the top, a
# project's own page, and every sentence that says a key is needed. Point it
# at your own installation; the default is the public one, so a dashboard
# nobody has configured still links somewhere true. Every one of those links
# opens in a new tab.
DASHBOARD_XTRACTING_URL=https://xtracting.io

# ── The password gate ───────────────────────────────────────────────────
# One shared password in front of EVERY page and every API call. Empty means
# no gate at all, which is right on a laptop or an intranet and wrong on
# anything with a public address.
#
# WHAT IT IS, AND WHAT IT IS NOT. This is a password gate against the outside,
# nothing more: there are no user accounts, no roles and no per-person rights
# in this dashboard, and none are intended. Its only purpose is that every
# person with access gets a personal key that can be rotated or withdrawn at
# any time without touching anybody else's.
#
# Several passwords, comma separated, each with a label of your own:
#
#   DASHBOARD_GATE_PASSWORD=anna:Xk7-tR9q_wm4,ben:P2s-vL8h_qz6
#
# The label is for you and for the log line that says which one was used. It
# is never shown to anybody who has not passed the gate - that would be a
# list of who has access. A single password with no label also works and is
# recorded as "default".
#
# Withdrawing one is one edit: remove the entry, then `docker compose down`
# and `up -d`. Every session ends at that moment, including the sessions of
# the passwords you kept - the cookie is signed with the whole set, so any
# change to it invalidates all of them.
#
# THE ALTERNATIVE, WITHOUT A RESTART: tokens in the archive. Instead of (or as
# well as) the list here, keys can live in the table dashboard.access_tokens,
# managed with ../../database/manage_tokens.sh - add one per person with a
# label and an expiry, list them, disable or delete one by its id. The
# dashboard reads that table every 30 seconds, so a token works or stops
# working within half a minute, no restart, and nobody else's session ends.
# The script needs bash and docker on the machine that runs the archive
# (Linux, or a Docker-compatible shell); the table itself can also be edited
# with any SQL client.
#
# CHARACTERS TO AVOID IN THE PASSWORD, and why. This is an env file read by
# docker compose and by the shell; several characters mean something before
# your password ever reaches the dashboard:
#
#   ,   separates the entries. Never usable inside a password.
#   :   separates label from password - but only the FIRST one, so
#       anna:a:b:c is anna with the password a:b:c. Safe after the first.
#   $   docker compose substitutes ${VAR} and $VAR, so a password with a
#       dollar in it silently loses part of itself - or becomes empty.
#   #   starts a comment in most .env readers when it follows a space.
#   "   '   quoting. A value that starts with one has to end with one, and
#       the quotes are then stripped rather than being part of the password.
#   \   an escape in a quoted value.
#   newline   a value cannot span lines.
#
# Leading and trailing spaces are trimmed and cannot be part of a password.
# Everything else is fine, including ! ? % & * ( ) - _ = + . / and any
# non-ASCII letter. Long is what makes a password strong; use more characters
# rather than stranger ones.
DASHBOARD_GATE_PASSWORD=

# Cloudflare Turnstile on the gate form itself, so the password box cannot be
# worked through by a machine.
#
# EITHER VARIABLE FILLED IN MEANS THE CHECK MUST PASS. Only both empty
# switches it off. That is deliberate and it is the opposite of the obvious
# reading: if a half-filled configuration merely disabled the check, then
# deleting the site key by accident - or mistyping one of these names -
# would quietly turn a protected dashboard back into a password box anybody
# may hammer, with nothing on the page to say so.
#
# So a half-configured gate lets NOBODY in, and the log names the missing
# half. A gate nobody can pass is loud and takes one edit to fix; a gate
# everybody can pass is silent.
#
# It fails closed in every other direction too: a token Cloudflare refuses,
# and a token it cannot be asked about because the network is down, are both
# a no.
#
# The keys are issued per domain at
# https://dash.cloudflare.com/?to=/:account/turnstile - so a dashboard on a
# bare IP or on localhost cannot have them. Leave BOTH empty there and the
# gate runs on the password alone.
DASHBOARD_TURNSTILE_SITE_KEY=
DASHBOARD_TURNSTILE_SECRET=

# How long one passing of the gate lasts, in hours. A day: long enough not to
# be a nuisance on a screen somebody keeps open, short enough that a borrowed
# laptop is not open for a month.
DASHBOARD_GATE_MAX_AGE_HOURS=24

# ── Limits ──────────────────────────────────────────────────────────────
# No single query may run longer than this. A summary over a large archive
# that hits the limit shows an error rather than holding a connection until
# someone notices.
#
# Five minutes, because a real archive is not a demo one: 8 million rows in
# 3900 daily chunks make a year-wide count across nine hypertables take
# minutes, and a limit that fires before the answer arrives turns a slow page
# into a broken one. The cost is the other way round - a runaway query keeps
# its pool connection for five minutes - so lower it if your archive is small
# and you would rather fail fast, raise it if you see the error on a query you
# know is only slow.
DASHBOARD_STATEMENT_TIMEOUT_SECONDS=300

# The Map stops expanding connections once this many entities are on it, and
# the Graph shows at most this many neighbours per node. Beyond these the
# picture stops being readable long before the browser stops being able to
# draw it.
# How many entities one connection search may draw. 0 is no limit, which is
# what a map of a network should be; put a number here only if an archive
# turns out to have a hub that makes the browser crawl.
DASHBOARD_MAP_MAX_ENTITIES=0
DASHBOARD_GRAPH_MAX_NEIGHBOURS=120

# ── Test crawls from the Sources page ───────────────────────────────────
# "Test this configuration" fetches the list page you typed, from this
# container. Addresses that resolve to private, loopback or link-local
# networks are refused, so the dashboard cannot be used to probe whatever else
# lives on your network. Set true only for a test site on the same machine.
DASHBOARD_ALLOW_PRIVATE_HOSTS=false

# A test crawl is cut off after this many seconds, whatever state it is in.
DASHBOARD_TEST_TIMEOUT_SECONDS=120

LOG_LEVEL=INFO
